.DS_Store
*/.DS_Store

node_modules
.jekyll-cache
_site
*.gem

# Build output. CI regenerates all of this from dev/ and assets/img/ via
# `npm run build`, so it is not committed. Lockfiles ARE committed, because
# `npm ci` and the Ruby setup action both require them.
assets/css/app.css
assets/js/app.js
assets/fonts/*.woff2
assets/img/generated/
assets/img/textures/
_data/images.json
dev/css/fonts.generated.css
